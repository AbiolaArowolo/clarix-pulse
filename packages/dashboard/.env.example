# Clarix Pulse - Dashboard (frontend) environment variables
# Copy this file to .env.local and fill in your value.
# Vite only exposes variables prefixed VITE_ to client-side code, and it
# inlines them into the built JS bundle - never put a secret key here.

# Clerk publishable key for this environment. This is the public/client-side
# key (safe to ship in the bundle) - pair it with the matching CLERK_SECRET_KEY
# on the hub (see the root .env.example) from the same Clerk instance.
# Find it in the Clerk dashboard under Configure > API Keys.
VITE_CLERK_PUBLISHABLE_KEY=
